# Ollama Local LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gaganyatri/sarvam-2b-v0.5

# ChromaDB Vector Store
CHROMA_PERSIST_DIR=./data/chroma_db

# Observability (Optional)
PHOENIX_HOST=localhost
PHOENIX_PORT=6006

# FastAPI Server
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# OCR — Tesseract executable & tessdata directory
STUDENT_REGISTER_OCR_DIR=D:\Student Register

# Plain Language Rewriter (Set true when using a capable instruction model like Llama 3)
USE_PLAIN_LANGUAGE_AI=false
